# Copy this file to .env (same folder) and fill it in. Never commit .env.
# cPanel: File Manager > Settings > Show Hidden Files, or this file stays invisible.

# The address people open, no trailing slash. Must match the Twitch OAuth redirect exactly.
APP_URL=https://alerts.example.com
APP_ENV=production

# At least 32 characters. In cPanel Terminal:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=

# Twitch application (https://dev.twitch.tv/console/apps)
# OAuth Redirect URL:  ${APP_URL}/callback.php
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch logins (or numeric IDs), comma-separated, that get the owner view.
ADMIN_TWITCH_LOGINS=

# true = only the accounts in ADMIN_TWITCH_LOGINS can log in.
# Fill in ADMIN_TWITCH_LOGINS first. With it empty, nobody can log in.
RESTRICT_LOGIN_TO_ADMINS=false

# cPanel > MySQL Databases. Use the prefixed names the panel shows, and localhost (not 127.0.0.1).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
