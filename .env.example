# Copy to .env and fill in. Never commit .env.

# Public base URL of the site, no trailing slash.
# Local Docker serves https://localhost (Caddy, port 443).
# Register exactly ${APP_URL}/callback.php as the Twitch OAuth redirect URL.
APP_URL=https://localhost
APP_ENV=production

# Long random string, at least 32 characters (used to derive the EventSub webhook secret).
# Generate one with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=

# Twitch application (https://dev.twitch.tv/console/apps)
#   OAuth Redirect URL must be exactly:  ${APP_URL}/callback.php
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Comma-separated Twitch logins (or numeric IDs) that get the site-owner /admin view.
ADMIN_TWITCH_LOGINS=

# true = only the accounts in ADMIN_TWITCH_LOGINS can log in (a private, single-owner site).
# Set ADMIN_TWITCH_LOGINS first: with it empty, nobody can log in.
RESTRICT_LOGIN_TO_ADMINS=false

# Used when PHP runs on the host. `docker compose` overrides these so the
# container talks to the database service instead of 127.0.0.1.
# On cPanel use DB_HOST=localhost, and the panel's prefixed database name and user.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=twitch_alerter
DB_USER=twitch_alerter
DB_PASS=

# Optional: path to a CA bundle if PHP's curl cannot verify TLS (common on Windows).
# CURL_CA_BUNDLE=C:\path\to\cacert.pem

# Optional: alert pack catalog (relative to the project folder). Without one, only custom alerts exist.
# ALERT_CATALOG=public/alerts/catalog.json
